# Frontend (Next.js)
NODE_ENV=development
PORT=3000

# URL interna do backend
# Local: http://127.0.0.1:3001 (padrao automatico em development)
# Coolify (compose): BACKEND_INTERNAL_URL=http://api:3001
# Railway: BACKEND_INTERNAL_URL=http://${{gestop.RAILWAY_PRIVATE_DOMAIN}}:${{gestop.PORT}}
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# Exibir credenciais demo no login (somente desenvolvimento local)
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# NAO definir em producao — quebra login no browser (use o proxy /api-gestop)
# NEXT_PUBLIC_API_URL=
