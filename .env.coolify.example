# Variáveis para docker-compose.coolify.yml — cole no Coolify (Environment).
# Não commitar com valores reais.
#
# ⚠ ARMADILHA CLÁSSICA (Coolify + Compose):
# NÃO coloque JWT_SECRET= ou INITIAL_ADMIN_PASSWORD= vazios no .env de interpolação
# do compose. `${JWT_SECRET:-}` no YAML vira string vazia e SOBRESCREVE o segredo
# que o Coolify injeta em runtime → entrypoint sai em ~2s → api unhealthy.
#
# Regra:
# - POSTGRES_* → Buildtime + Runtime (precisam estar no .env do compose para DATABASE_URL)
# - JWT_SECRET / INITIAL_ADMIN_PASSWORD / outros segredos → só Runtime no Coolify
#   (NÃO listados no compose environment; NÃO deixá-los em branco no .env do compose)

# Banco (interno ao compose) — Build Variable (obrigatório para interpolar DATABASE_URL)
POSTGRES_USER=gestop
POSTGRES_PASSWORD=senha-forte-aqui
POSTGRES_DB=gestop

# --- Segurança: só no Coolify Environment (RUNTIME) — OBRIGATÓRIO ---
# NÃO coloque estas chaves no .env do compose com valor vazio.
# No painel Coolify → Environment → adicione como Runtime (não precisa Buildtime):
#   JWT_SECRET=<openssl rand -base64 48>          # ≥32 chars — OBRIGATÓRIO
#   INITIAL_ADMIN_PASSWORD=<senha-forte-12+>      # 1º seed — recomendado
#
# Segredos opcionais (mesma regra — só runtime, nunca ${VAR:-} no compose):
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
#   WEB_PUSH_VAPID_PUBLIC_KEY / WEB_PUSH_VAPID_PRIVATE_KEY / WEB_PUSH_VAPID_SUBJECT
#   BACKUP_ENCRYPTION_KEY / WEBMAP_CRON_SECRET / INTEGRACOES_WEBHOOK_SECRET

# true só no 1º deploy se quiser forçar re-seed; depois false
RUN_SEED=false
FORCE_SEED_ON_START=false

# URL pública do frontend (CORS + links) — https, sem barra final
# Pode ficar vazio se SERVICE_URL_WEB for injetado pelo Coolify (domínio do serviço web)
CORS_ORIGINS=
STORAGE_PUBLIC_URL_BASE=
FRONTEND_PUBLIC_URL=

# Storage local (volume api_storage montado em /data/gestop-evidencias)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/gestop-evidencias

# Proxy interno Next.js → Nest (rede Docker). Padrão do compose: http://api:3001
BACKEND_INTERNAL_URL=http://api:3001

# Importação automática de unidades (GitHub webmap) — default false (1º boot mais confiável)
# Ative true depois se quiser import no startup; falha de rede NÃO derruba a API
WEBMAP_AUTO_IMPORT_ON_START=false

# --- Opcionais (não-segredo) ---
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# SENTRY_DSN=
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_PUBLIC_URL_BASE=
