# Variáveis para docker-compose.coolify.yml — cole no Coolify (Environment).
# Não commitar com valores reais.
#
# Coolify: marque as variáveis marcadas abaixo como "Available at Buildtime".
# Sem JWT_SECRET válido a API aborta no boot → container unhealthy → web não sobe.

# Banco (interno ao compose) — Build Variable
POSTGRES_USER=gestop
POSTGRES_PASSWORD=senha-forte-aqui
POSTGRES_DB=gestop

# Segurança — OBRIGATÓRIO ≥32 chars — openssl rand -base64 48 — Build Variable
JWT_SECRET=

# Senha do admin no 1º seed (min. 12 caracteres) — Build Variable no 1º deploy
# Se vazio, seed usa Gestop@123 (troque após login)
INITIAL_ADMIN_PASSWORD=

# true só no 1º deploy se quiser forçar re-seed; depois false
RUN_SEED=false
FORCE_SEED_ON_START=false

# URL pública do frontend (CORS + links) — https, sem barra final
# Pode ficar vazio se SERVICE_URL_WEB for injetado pelo Coolify (domínio do serviço web)
CORS_ORIGINS=
STORAGE_PUBLIC_URL_BASE=
FRONTEND_PUBLIC_URL=

# Storage local (volume api_storage montado em /data/gestop-evidencias)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/gestop-evidencias

# Proxy interno Next.js → Nest (rede Docker). Padrão do compose: http://api:3001
BACKEND_INTERNAL_URL=http://api:3001

# Importação automática de unidades (GitHub webmap) no 1º boot com banco vazio
# Falha de rede NÃO derruba a API; desative se outbound for bloqueado
WEBMAP_AUTO_IMPORT_ON_START=true

# --- Opcionais ---
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# SENTRY_DSN=
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:gestop@franca.sp.gov.br
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=
